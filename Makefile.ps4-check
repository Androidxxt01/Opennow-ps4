ROOT := $(abspath .)
OPENORBIS ?= /opt/OpenOrbis-PS4-Toolchain
CC = clang
CXX = clang++
JANSSON_INCLUDE ?= $(OPENORBIS)/include
BUILD_DIR ?= build/ps4-check
TARGET := --target=x86_64-pc-freebsd12-elf
COMMON_FLAGS := $(TARGET) -D__PS4__ -D__Userspace__ -DSCTP_SIMPLE_ALLOCATOR \
	-I$(ROOT)/app/src -I$(ROOT)/extern/libpeer/src \
	-I$(ROOT)/extern/ffmpeg/include \
	-I$(ROOT)/extern/libpeer/third_party/usrsctp/usrsctplib \
	-I$(ROOT)/extern/libpeer/third_party/mbedtls/include \
	-I$(JANSSON_INCLUDE) -nostdlibinc
C_INCLUDE_FLAGS := -isystem $(OPENORBIS)/include
CXX_INCLUDE_FLAGS := -nostdinc++ -isystem $(LIBCXX_INCLUDE) $(C_INCLUDE_FLAGS)
CFLAGS ?= -std=c11 -Wall -Wextra -D_GNU_SOURCE -DHTTP_DO_NOT_USE_CUSTOM_CONFIG -DMQTT_DO_NOT_USE_CUSTOM_CONFIG -ferror-limit=0
CXXFLAGS ?= -std=c++20 -Wall -Wextra -D_GNU_SOURCE -DHTTP_DO_NOT_USE_CUSTOM_CONFIG -DMQTT_DO_NOT_USE_CUSTOM_CONFIG -ferror-limit=0

USRSCTP_DIR := $(ROOT)/extern/libpeer/third_party/usrsctp/usrsctplib
# O alvo freebsd12 define __FreeBSD__ por padrao; usrsctp precisa do caminho
# userspace generico (o mesmo do CMake do Switch), nao dos ramos de kernel.
USRSCTP_CFLAGS := -U__FreeBSD__ -D_GNU_SOURCE -DSCTP_PROCESS_LEVEL_LOCKS
USRSCTP_SOURCES := \
	$(USRSCTP_DIR)/netinet/sctp_asconf.c \
	$(USRSCTP_DIR)/netinet/sctp_auth.c \
	$(USRSCTP_DIR)/netinet/sctp_bsd_addr.c \
	$(USRSCTP_DIR)/netinet/sctp_callout.c \
	$(USRSCTP_DIR)/netinet/sctp_cc_functions.c \
	$(USRSCTP_DIR)/netinet/sctp_crc32.c \
	$(USRSCTP_DIR)/netinet/sctp_indata.c \
	$(USRSCTP_DIR)/netinet/sctp_input.c \
	$(USRSCTP_DIR)/netinet/sctp_output.c \
	$(USRSCTP_DIR)/netinet/sctp_pcb.c \
	$(USRSCTP_DIR)/netinet/sctp_peeloff.c \
	$(USRSCTP_DIR)/netinet/sctp_sha1.c \
	$(USRSCTP_DIR)/netinet/sctp_ss_functions.c \
	$(USRSCTP_DIR)/netinet/sctp_sysctl.c \
	$(USRSCTP_DIR)/netinet/sctp_timer.c \
	$(USRSCTP_DIR)/netinet/sctp_userspace.c \
	$(USRSCTP_DIR)/netinet/sctp_usrreq.c \
	$(USRSCTP_DIR)/netinet/sctputil.c \
	$(USRSCTP_DIR)/netinet6/sctp6_usrreq.c \
	$(USRSCTP_DIR)/user_environment.c \
	$(USRSCTP_DIR)/user_mbuf.c \
	$(USRSCTP_DIR)/user_recv_thread.c \
	$(USRSCTP_DIR)/user_socket.c
GFN_SOURCES := $(wildcard $(ROOT)/app/src/gfn/*.cpp)
WEBRTC_SOURCES := \
	$(ROOT)/app/src/webrtc/diagnostics.cpp \
	$(ROOT)/app/src/webrtc/diagnostic_writer.cpp \
	$(ROOT)/app/src/webrtc/input.cpp \
	$(ROOT)/app/src/webrtc/media.cpp \
	$(ROOT)/app/src/webrtc/negotiation.cpp \
	$(ROOT)/app/src/webrtc/nvst_sdp.cpp \
	$(ROOT)/app/src/webrtc/shared.cpp \
	$(ROOT)/app/src/webrtc/signaling.cpp
LIBPEER_DIR := $(ROOT)/extern/libpeer/src
WEBRTC_DIR := $(ROOT)/app/src/webrtc
LIBPEER_SOURCES := $(wildcard $(LIBPEER_DIR)/*.c)
SRTP_HEADER := $(BUILD_DIR)/include/srtp2/srtp.h
LIBPEER_INCLUDE_FLAGS := -I$(ROOT)/extern/libpeer/third_party/cJSON \
	-I$(ROOT)/extern/libpeer/third_party/coreHTTP/source/include \
	-I$(ROOT)/extern/libpeer/third_party/coreHTTP/source/interface \
	-I$(ROOT)/extern/libpeer/third_party/coreMQTT/source/include \
	-I$(ROOT)/extern/libpeer/third_party/coreMQTT/source/interface \
	-I$(BUILD_DIR)/include
WEBRTC_INCLUDE_FLAGS := -I$(ROOT)/extern/borealis/library/include/borealis/extern/nanovg
MBEDTLS_DIR := $(ROOT)/extern/libpeer/third_party/mbedtls
MBEDTLS_LIBRARY_DIR := $(MBEDTLS_DIR)/library
MBEDTLS_GEN_DIR := $(BUILD_DIR)/mbedtls-generated
MBEDTLS_CONFIG_DEFINE := -DMBEDTLS_CONFIG_FILE='"mbedtls/mbedtls_config.h"'
SSL_DEBUG_HELPERS := $(MBEDTLS_GEN_DIR)/ssl_debug_helpers_generated.c
MBEDTLS_SOURCES := $(filter-out \
	$(MBEDTLS_LIBRARY_DIR)/psa_crypto%.c \
	$(MBEDTLS_LIBRARY_DIR)/psa_its_file.c, \
	$(wildcard $(MBEDTLS_LIBRARY_DIR)/*.c))
MBEDTLS_SOURCES += $(ROOT)/extern/libpeer/src/ps4_mbedtls_entropy.c $(SSL_DEBUG_HELPERS)
USRSCTP_OBJECTS := $(patsubst $(ROOT)/%,$(BUILD_DIR)/%.o,$(USRSCTP_SOURCES))
GFN_OBJECTS := $(patsubst $(ROOT)/%,$(BUILD_DIR)/%.o,$(GFN_SOURCES))
WEBRTC_OBJECTS := $(patsubst $(ROOT)/%,$(BUILD_DIR)/%.o,$(WEBRTC_SOURCES))
LIBPEER_OBJECTS := $(patsubst $(ROOT)/%,$(BUILD_DIR)/%.o,$(LIBPEER_SOURCES))
MBEDTLS_OBJECTS := $(patsubst $(ROOT)/%,$(BUILD_DIR)/mbedtls/%.o,$(filter $(ROOT)/%,$(MBEDTLS_SOURCES))) \
	$(BUILD_DIR)/mbedtls/ssl_debug_helpers_generated.c.o
MBEDTLS_ARCHIVE := $(BUILD_DIR)/libmbedtls-check.a
OPENORBIS_LIBS := -L$(OPENORBIS)/lib -lc -lkernel -lSceNet -lSceNetCtl \
	-lScePosix -lSceLibcInternal -lc++ -lc++abi -lc++experimental
LINK_MAIN := $(ROOT)/tests/ps4/link_main.c
LINK_MAIN_OBJECT := $(BUILD_DIR)/tests/ps4/link_main.c.o
LINK_ARCHIVES := \
	$(BUILD_DIR)/libusrsctp-check.a \
	$(BUILD_DIR)/libgfn-check.a \
	$(BUILD_DIR)/libwebrtc-check.a \
	$(BUILD_DIR)/liblibpeer-check.a \
	$(MBEDTLS_ARCHIVE)
LINK_TARGET := $(BUILD_DIR)/ps4-link-check

.PHONY: all usrsctp gfn webrtc libpeer mbedtls link clean
all: usrsctp gfn webrtc libpeer

usrsctp: $(USRSCTP_OBJECTS)
gfn: $(GFN_OBJECTS)
webrtc: $(WEBRTC_OBJECTS)
libpeer: $(LIBPEER_OBJECTS)
mbedtls: $(MBEDTLS_ARCHIVE)
link: $(LINK_TARGET)

$(LIBPEER_OBJECTS): $(SRTP_HEADER)

$(LINK_MAIN_OBJECT): $(LINK_MAIN)
	@mkdir -p $(dir $@)
	$(CXX) -x c++ $(COMMON_FLAGS) $(CXX_INCLUDE_FLAGS) $(CXXFLAGS) -c $< -o $@

$(BUILD_DIR)/libusrsctp-check.a: $(USRSCTP_OBJECTS)
	ar rcs $@ $^
$(BUILD_DIR)/libgfn-check.a: $(GFN_OBJECTS)
	ar rcs $@ $^
$(BUILD_DIR)/libwebrtc-check.a: $(WEBRTC_OBJECTS)
	ar rcs $@ $^
$(BUILD_DIR)/liblibpeer-check.a: $(LIBPEER_OBJECTS)
	ar rcs $@ $^

$(SSL_DEBUG_HELPERS):
	@mkdir -p $(dir $@)
	python3 $(MBEDTLS_DIR)/scripts/generate_ssl_debug_helpers.py --mbedtls-root $(MBEDTLS_DIR) $(MBEDTLS_GEN_DIR)

$(BUILD_DIR)/mbedtls/%.c.o: $(ROOT)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(COMMON_FLAGS) $(C_INCLUDE_FLAGS) $(CFLAGS) $(MBEDTLS_CONFIG_DEFINE) -w -c $< -o $@

$(BUILD_DIR)/mbedtls/ssl_debug_helpers_generated.c.o: $(SSL_DEBUG_HELPERS)
	@mkdir -p $(dir $@)
	$(CC) $(COMMON_FLAGS) $(C_INCLUDE_FLAGS) $(CFLAGS) $(MBEDTLS_CONFIG_DEFINE) -I$(MBEDTLS_LIBRARY_DIR) -I$(MBEDTLS_GEN_DIR) -w -c $< -o $@

$(MBEDTLS_ARCHIVE): $(MBEDTLS_OBJECTS)
	ar rcs $@ $^

$(LINK_TARGET): $(LINK_MAIN_OBJECT) $(LINK_ARCHIVES)
	$(CXX) $(COMMON_FLAGS) $(CXX_INCLUDE_FLAGS) $(CXXFLAGS) \
		-fuse-ld=lld -nostdlib \
		$(LINK_MAIN_OBJECT) \
		-Wl,--start-group $(LINK_ARCHIVES) -Wl,--end-group \
		$(OPENORBIS_LIBS) \
		-Wl,--unresolved-symbols=report-all -Wl,--error-limit=0 \
		-o $@

$(SRTP_HEADER): $(ROOT)/extern/libpeer/third_party/libsrtp/include/srtp.h
	mkdir -p $(dir $@)
	cp $< $@

$(BUILD_DIR)/%.c.o: $(ROOT)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(COMMON_FLAGS) $(C_INCLUDE_FLAGS) $(CFLAGS) \
		$(if $(filter $(USRSCTP_DIR)/%,$<),$(USRSCTP_CFLAGS)) \
		$(if $(filter $(LIBPEER_DIR)/%,$<),$(LIBPEER_INCLUDE_FLAGS)) \
		-c $< -o $@

$(BUILD_DIR)/%.cpp.o: $(ROOT)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(COMMON_FLAGS) $(CXX_INCLUDE_FLAGS) $(CXXFLAGS) \
		$(if $(filter $(WEBRTC_DIR)/%,$<),$(WEBRTC_INCLUDE_FLAGS)) \
		-c $< -o $@

clean:
	rm -rf $(BUILD_DIR)
