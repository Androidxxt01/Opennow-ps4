ROOT := $(abspath .)
OPENORBIS ?= /opt/OpenOrbis-PS4-Toolchain
CC = clang
CXX = clang++
LD := ld.lld
AR ?= llvm-ar
BUILD_DIR ?= build/ps4-check
JANSSON_DIR ?= $(CURDIR)/$(BUILD_DIR)/jansson
JANSSON_SRC_DIR := $(JANSSON_DIR)/src
JANSSON_INCLUDE := $(JANSSON_SRC_DIR)
TARGET := --target=x86_64-pc-freebsd12-elf
COMMON_FLAGS := $(TARGET) -D__PS4__ -D__Userspace__ -DSCTP_SIMPLE_ALLOCATOR \
	-I$(ROOT)/app/src -I$(ROOT)/extern/libpeer/src \
	-I$(ROOT)/extern/ffmpeg/include \
	-I$(ROOT)/extern/libpeer/third_party/usrsctp/usrsctplib \
	-I$(ROOT)/extern/libpeer/third_party/mbedtls/include \
	-I$(JANSSON_INCLUDE) -nostdlibinc
C_INCLUDE_FLAGS := -isystem $(OPENORBIS)/include
CXX_INCLUDE_FLAGS := -nostdinc++ -isystem $(LIBCXX_INCLUDE) $(C_INCLUDE_FLAGS)
CFLAGS ?= -std=c11 -Wall -Wextra -D_GNU_SOURCE -DHTTP_DO_NOT_USE_CUSTOM_CONFIG -DMQTT_DO_NOT_USE_CUSTOM_CONFIG -fPIC -ferror-limit=0
CXXFLAGS ?= -std=c++20 -Wall -Wextra -D_GNU_SOURCE -DHTTP_DO_NOT_USE_CUSTOM_CONFIG -DMQTT_DO_NOT_USE_CUSTOM_CONFIG -fPIC -ferror-limit=0

USRSCTP_DIR := $(ROOT)/extern/libpeer/third_party/usrsctp/usrsctplib
# O alvo freebsd12 define __FreeBSD__ por padrao; usrsctp precisa do caminho
# userspace generico (o mesmo do CMake do Switch), nao dos ramos de kernel.
USRSCTP_CFLAGS := -U__FreeBSD__ -D_GNU_SOURCE -DSCTP_PROCESS_LEVEL_LOCKS
USRSCTP_SOURCES := \
	$(USRSCTP_DIR)/netinet/sctp_asconf.c \
	$(USRSCTP_DIR)/netinet/sctp_auth.c \
	$(USRSCTP_DIR)/netinet/sctp_bsd_addr.c \
	$(USRSCTP_DIR)/netinet/sctp_callout.c \
	$(USRSCTP_DIR)/netinet/sctp_cc_functions.c \
	$(USRSCTP_DIR)/netinet/sctp_crc32.c \
	$(USRSCTP_DIR)/netinet/sctp_indata.c \
	$(USRSCTP_DIR)/netinet/sctp_input.c \
	$(USRSCTP_DIR)/netinet/sctp_output.c \
	$(USRSCTP_DIR)/netinet/sctp_pcb.c \
	$(USRSCTP_DIR)/netinet/sctp_peeloff.c \
	$(USRSCTP_DIR)/netinet/sctp_sha1.c \
	$(USRSCTP_DIR)/netinet/sctp_ss_functions.c \
	$(USRSCTP_DIR)/netinet/sctp_sysctl.c \
	$(USRSCTP_DIR)/netinet/sctp_timer.c \
	$(USRSCTP_DIR)/netinet/sctp_userspace.c \
	$(USRSCTP_DIR)/netinet/sctp_usrreq.c \
	$(USRSCTP_DIR)/netinet/sctputil.c \
	$(USRSCTP_DIR)/netinet6/sctp6_usrreq.c \
	$(USRSCTP_DIR)/user_environment.c \
	$(USRSCTP_DIR)/user_mbuf.c \
	$(USRSCTP_DIR)/user_recv_thread.c \
	$(USRSCTP_DIR)/user_socket.c
GFN_SOURCES := $(wildcard $(ROOT)/app/src/gfn/*.cpp)
WEBRTC_SOURCES := \
	$(ROOT)/app/src/webrtc/diagnostics.cpp \
	$(ROOT)/app/src/webrtc/diagnostic_writer.cpp \
	$(ROOT)/app/src/webrtc/input.cpp \
	$(ROOT)/app/src/webrtc/media.cpp \
	$(ROOT)/app/src/webrtc/negotiation.cpp \
	$(ROOT)/app/src/webrtc/nvst_sdp.cpp \
	$(ROOT)/app/src/webrtc/shared.cpp \
	$(ROOT)/app/src/webrtc/signaling.cpp \
	$(ROOT)/app/src/stream_diagnostics.cpp \
	$(ROOT)/app/src/mbedtls_timing_compat.c
LIBPEER_DIR := $(ROOT)/extern/libpeer/src
WEBRTC_DIR := $(ROOT)/app/src/webrtc
LIBPEER_SOURCES := $(wildcard $(LIBPEER_DIR)/*.c)
SRTP_DIR := $(ROOT)/extern/libpeer/third_party/libsrtp
SRTP_TEMPLATE := $(SRTP_DIR)/config_in_cmake.h
SRTP_CONFIG := $(BUILD_DIR)/include/config.h
SRTP_SOURCES := \
	$(SRTP_DIR)/srtp/srtp.c \
	$(SRTP_DIR)/crypto/cipher/cipher.c \
	$(SRTP_DIR)/crypto/cipher/cipher_test_cases.c \
	$(SRTP_DIR)/crypto/cipher/null_cipher.c \
	$(SRTP_DIR)/crypto/cipher/aes.c \
	$(SRTP_DIR)/crypto/cipher/aes_icm.c \
	$(SRTP_DIR)/crypto/hash/auth.c \
	$(SRTP_DIR)/crypto/hash/auth_test_cases.c \
	$(SRTP_DIR)/crypto/hash/null_auth.c \
	$(SRTP_DIR)/crypto/hash/hmac.c \
	$(SRTP_DIR)/crypto/hash/sha1.c \
	$(SRTP_DIR)/crypto/kernel/alloc.c \
	$(SRTP_DIR)/crypto/kernel/crypto_kernel.c \
	$(SRTP_DIR)/crypto/kernel/err.c \
	$(SRTP_DIR)/crypto/kernel/key.c \
	$(SRTP_DIR)/crypto/math/datatypes.c \
	$(SRTP_DIR)/crypto/replay/rdb.c \
	$(SRTP_DIR)/crypto/replay/rdbx.c
SRTP_ARCHIVE := $(BUILD_DIR)/libsrtp-check.a
SRTP_CFLAGS := -DHAVE_CONFIG_H -I$(SRTP_DIR)/crypto/include \
	-I$(SRTP_DIR)/include -I$(BUILD_DIR)/include -include $(SRTP_CONFIG) -include strings.h -include stddef.h
SRTP_HEADER := $(BUILD_DIR)/include/srtp2/srtp.h
LIBPEER_INCLUDE_FLAGS := -I$(ROOT)/extern/libpeer/third_party/cJSON \
	-I$(ROOT)/extern/libpeer/third_party/coreHTTP/source/include \
	-I$(ROOT)/extern/libpeer/third_party/coreHTTP/source/interface \
	-I$(ROOT)/extern/libpeer/third_party/coreMQTT/source/include \
	-I$(ROOT)/extern/libpeer/third_party/coreMQTT/source/interface \
	-I$(BUILD_DIR)/include
WEBRTC_INCLUDE_FLAGS := -I$(ROOT)/extern/borealis/library/include/borealis/extern/nanovg
MBEDTLS_DIR := $(ROOT)/extern/libpeer/third_party/mbedtls
MBEDTLS_LIBRARY_DIR := $(MBEDTLS_DIR)/library
MBEDTLS_GEN_DIR := $(BUILD_DIR)/mbedtls-generated
MBEDTLS_SCRIPTS := $(MBEDTLS_DIR)/scripts
MBEDTLS_CONFIG_DEFINE := -DMBEDTLS_CONFIG_FILE='"mbedtls/mbedtls_config.h"'
SSL_DEBUG_HELPERS := $(MBEDTLS_GEN_DIR)/ssl_debug_helpers_generated.c
PSA_DRIVER_WRAPPERS := $(MBEDTLS_GEN_DIR)/psa_crypto_driver_wrappers.c
PYTHON ?= python3
PSA_GEN_AVAILABLE := $(shell PYTHONPATH=$(MBEDTLS_SCRIPTS) $(PYTHON) -c 'import jinja2,jsonschema,mbedtls_dev.build_tree' >/dev/null 2>&1 && echo yes)
MBEDTLS_SOURCES := $(filter-out \
	$(MBEDTLS_LIBRARY_DIR)/psa_crypto%.c \
	$(MBEDTLS_LIBRARY_DIR)/psa_its_file.c, \
	$(wildcard $(MBEDTLS_LIBRARY_DIR)/*.c))
ifeq ($(PSA_GEN_AVAILABLE),yes)
MBEDTLS_SOURCES := $(filter-out \
	$(MBEDTLS_LIBRARY_DIR)/psa_crypto_driver_wrappers.c, \
	$(wildcard $(MBEDTLS_LIBRARY_DIR)/*.c))
MBEDTLS_SOURCES += $(PSA_DRIVER_WRAPPERS)
endif
MBEDTLS_SOURCES += $(ROOT)/extern/libpeer/src/ps4_mbedtls_entropy.c $(SSL_DEBUG_HELPERS)
USRSCTP_OBJECTS := $(patsubst $(ROOT)/%,$(BUILD_DIR)/%.o,$(USRSCTP_SOURCES))
GFN_OBJECTS := $(patsubst $(ROOT)/%,$(BUILD_DIR)/%.o,$(GFN_SOURCES))
WEBRTC_OBJECTS := $(patsubst $(ROOT)/%,$(BUILD_DIR)/%.o,$(WEBRTC_SOURCES))
LIBPEER_OBJECTS := $(patsubst $(ROOT)/%,$(BUILD_DIR)/%.o,$(LIBPEER_SOURCES))
SRTP_OBJECTS := $(patsubst $(ROOT)/%,$(BUILD_DIR)/%.o,$(SRTP_SOURCES))
MBEDTLS_OBJECTS := $(patsubst $(ROOT)/%,$(BUILD_DIR)/mbedtls/%.o,$(filter $(ROOT)/%,$(MBEDTLS_SOURCES))) \
	$(patsubst $(MBEDTLS_GEN_DIR)/%,$(BUILD_DIR)/mbedtls/generated/%.o,$(filter $(MBEDTLS_GEN_DIR)/%,$(MBEDTLS_SOURCES)))
MBEDTLS_ARCHIVE := $(BUILD_DIR)/libmbedtls-check.a
JANSSON_SOURCES := $(wildcard $(JANSSON_SRC_DIR)/*.c)
JANSSON_OBJECTS := $(patsubst $(JANSSON_SRC_DIR)/%,$(BUILD_DIR)/jansson/%.o,$(JANSSON_SOURCES))
JANSSON_ARCHIVE := $(BUILD_DIR)/libjansson-check.a
JANSSON_PRIVATE_CONFIG := $(JANSSON_DIR)/jansson_private_config.h
JANSSON_PUBLIC_CONFIG := $(JANSSON_SRC_DIR)/jansson_config.h
OPENORBIS_LIBS := -L$(OPENORBIS)/lib -lc -lkernel -lSceNet -lSceNetCtl \
	-lScePosix -lSceLibcInternal -lc++ -lc++abi -lc++experimental
LINK_MAIN := $(ROOT)/tests/ps4/link_main.c
LINK_MAIN_OBJECT := $(BUILD_DIR)/tests/ps4/link_main.c.o
ENTROPY_MAIN := $(ROOT)/tests/ps4/entropy_main.c
ENTROPY_MAIN_OBJECT := $(BUILD_DIR)/tests/ps4/entropy_main.c.o
ENTROPY_TARGET := $(BUILD_DIR)/ps4-entropy-check
LINK_ARCHIVES := \
	$(BUILD_DIR)/libusrsctp-check.a \
	$(BUILD_DIR)/libgfn-check.a \
	$(BUILD_DIR)/libwebrtc-check.a \
	$(BUILD_DIR)/liblibpeer-check.a \
	$(SRTP_ARCHIVE) \
	$(MBEDTLS_ARCHIVE) \
	$(JANSSON_ARCHIVE)
LINK_TARGET := $(BUILD_DIR)/ps4-link-check

.PHONY: all usrsctp gfn webrtc libpeer srtp mbedtls link entropy clean
all: usrsctp gfn webrtc libpeer srtp

usrsctp: $(USRSCTP_OBJECTS)
gfn: $(GFN_OBJECTS)
webrtc: $(WEBRTC_OBJECTS)
libpeer: $(LIBPEER_OBJECTS)
srtp: $(SRTP_OBJECTS)
mbedtls: $(MBEDTLS_ARCHIVE)
link: $(LINK_TARGET)
entropy: $(ENTROPY_TARGET)

$(LIBPEER_OBJECTS): $(SRTP_HEADER)
$(SRTP_OBJECTS): $(SRTP_CONFIG) $(SRTP_HEADER)

$(LINK_MAIN_OBJECT): $(LINK_MAIN)
	@mkdir -p $(dir $@)
	$(CXX) -x c++ $(COMMON_FLAGS) $(CXX_INCLUDE_FLAGS) $(CXXFLAGS) -c $< -o $@

$(BUILD_DIR)/libusrsctp-check.a: $(USRSCTP_OBJECTS)
	$(AR) rcs $@ $^
$(BUILD_DIR)/libgfn-check.a: $(GFN_OBJECTS)
	$(AR) rcs $@ $^
$(BUILD_DIR)/libwebrtc-check.a: $(WEBRTC_OBJECTS)
	$(AR) rcs $@ $^
$(BUILD_DIR)/liblibpeer-check.a: $(LIBPEER_OBJECTS)
	$(AR) rcs $@ $^
$(SRTP_ARCHIVE): $(SRTP_OBJECTS)
	$(AR) rcs $@ $^

$(SSL_DEBUG_HELPERS):
	@mkdir -p $(dir $@)
	$(PYTHON) $(MBEDTLS_DIR)/scripts/generate_ssl_debug_helpers.py --mbedtls-root $(MBEDTLS_DIR) $(MBEDTLS_GEN_DIR)

$(PSA_DRIVER_WRAPPERS):
	@mkdir -p $(dir $@)
	PYTHONPATH=$(MBEDTLS_SCRIPTS) $(PYTHON) $(MBEDTLS_DIR)/scripts/generate_driver_wrappers.py $(MBEDTLS_GEN_DIR)

$(BUILD_DIR)/mbedtls/%.c.o: $(ROOT)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(COMMON_FLAGS) $(C_INCLUDE_FLAGS) $(CFLAGS) $(MBEDTLS_CONFIG_DEFINE) -I$(MBEDTLS_LIBRARY_DIR) -w -c $< -o $@

$(BUILD_DIR)/mbedtls/ssl_debug_helpers_generated.c.o: $(SSL_DEBUG_HELPERS)
	@mkdir -p $(dir $@)
	$(CC) $(COMMON_FLAGS) $(C_INCLUDE_FLAGS) $(CFLAGS) $(MBEDTLS_CONFIG_DEFINE) -I$(MBEDTLS_LIBRARY_DIR) -I$(MBEDTLS_GEN_DIR) -w -c $< -o $@

$(BUILD_DIR)/mbedtls/generated/%.c.o: $(MBEDTLS_GEN_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(COMMON_FLAGS) $(C_INCLUDE_FLAGS) $(CFLAGS) $(MBEDTLS_CONFIG_DEFINE) -I$(MBEDTLS_LIBRARY_DIR) -I$(MBEDTLS_GEN_DIR) -w -c $< -o $@

$(MBEDTLS_ARCHIVE): $(MBEDTLS_OBJECTS)
	$(AR) rcs $@ $^

$(JANSSON_PRIVATE_CONFIG): $(JANSSON_DIR)/jansson_private_config.h.in
	@mkdir -p $(dir $@)
	sed \
		-e 's/#undef HAVE_ATOMIC_BUILTINS/#define HAVE_ATOMIC_BUILTINS 1/' \
		-e 's/#undef HAVE_CLOSE/#define HAVE_CLOSE 1/' \
		-e 's/#undef HAVE_FCNTL_H/#define HAVE_FCNTL_H 1/' \
		-e 's/#undef HAVE_GETPID/#define HAVE_GETPID 1/' \
		-e 's/#undef HAVE_GETTIMEOFDAY/#define HAVE_GETTIMEOFDAY 1/' \
		-e 's/#undef HAVE_INTTYPES_H/#define HAVE_INTTYPES_H 1/' \
		-e 's/#undef HAVE_LOCALECONV/#define HAVE_LOCALECONV 1/' \
		-e 's/#undef HAVE_LOCALE_H/#define HAVE_LOCALE_H 1/' \
		-e 's/#undef HAVE_LONG_LONG_INT/#define HAVE_LONG_LONG_INT 1/' \
		-e 's/#undef HAVE_MEMORY_H/#define HAVE_MEMORY_H 1/' \
		-e 's/#undef HAVE_OPEN/#define HAVE_OPEN 1/' \
		-e 's/#undef HAVE_READ/#define HAVE_READ 1/' \
		-e 's/#undef HAVE_SCHED_H/#define HAVE_SCHED_H 1/' \
		-e 's/#undef HAVE_SCHED_YIELD/#define HAVE_SCHED_YIELD 1/' \
		-e 's/#undef HAVE_STDINT_H/#define HAVE_STDINT_H 1/' \
		-e 's/#undef HAVE_STDLIB_H/#define HAVE_STDLIB_H 1/' \
		-e 's/#undef HAVE_STRINGS_H/#define HAVE_STRINGS_H 1/' \
		-e 's/#undef HAVE_STRING_H/#define HAVE_STRING_H 1/' \
		-e 's/#undef HAVE_STRTOLL/#define HAVE_STRTOLL 1/' \
		-e 's/#undef HAVE_SYNC_BUILTINS/#define HAVE_SYNC_BUILTINS 1/' \
		-e 's/#undef HAVE_SYS_PARAM_H/#define HAVE_SYS_PARAM_H 1/' \
		-e 's/#undef HAVE_SYS_STAT_H/#define HAVE_SYS_STAT_H 1/' \
		-e 's/#undef HAVE_SYS_TIME_H/#define HAVE_SYS_TIME_H 1/' \
		-e 's/#undef HAVE_SYS_TYPES_H/#define HAVE_SYS_TYPES_H 1/' \
		-e 's/#undef HAVE_UNISTD_H/#define HAVE_UNISTD_H 1/' \
		-e 's/#undef HAVE_UNSIGNED_LONG_LONG_INT/#define HAVE_UNSIGNED_LONG_LONG_INT 1/' \
		-e 's/#undef INITIAL_HASHTABLE_ORDER/#define INITIAL_HASHTABLE_ORDER 3/' \
		-e 's/#undef STDC_HEADERS/#define STDC_HEADERS 1/' \
		-e 's/#undef USE_URANDOM/\/* #undef USE_URANDOM *\//' \
		-e 's/#undef USE_WINDOWS_CRYPTOAPI/\/* #undef USE_WINDOWS_CRYPTOAPI *\//' \
		-e 's/#undef inline//g' \
		$< > $@

$(JANSSON_PUBLIC_CONFIG): $(JANSSON_SRC_DIR)/jansson_config.h.in
	@mkdir -p $(dir $@)
	sed \
		-e 's/@json_inline@/inline/' \
		-e 's/@json_have_long_long@/1/' \
		-e 's/@json_have_localeconv@/1/' \
		-e 's/@json_have_atomic_builtins@/1/' \
		-e 's/@json_have_sync_builtins@/1/' \
		$< > $@

$(BUILD_DIR)/jansson/%.c.o: $(JANSSON_SRC_DIR)/%.c $(JANSSON_PRIVATE_CONFIG) $(JANSSON_PUBLIC_CONFIG)
	@mkdir -p $(dir $@)
	$(CC) $(COMMON_FLAGS) $(C_INCLUDE_FLAGS) $(CFLAGS) -DHAVE_CONFIG_H -I$(JANSSON_DIR) -I$(JANSSON_SRC_DIR) -w -c $< -o $@

$(JANSSON_ARCHIVE): $(JANSSON_OBJECTS)
	$(AR) rcs $@ $^

$(ENTROPY_MAIN_OBJECT): $(ENTROPY_MAIN)
	@mkdir -p $(dir $@)
	$(CC) $(COMMON_FLAGS) $(C_INCLUDE_FLAGS) $(CFLAGS) -fPIC -c $< -o $@

$(ENTROPY_TARGET): $(ENTROPY_MAIN_OBJECT) $(BUILD_DIR)/libmbedtls-check.a $(BUILD_DIR)/liblibpeer-check.a
	$(LD) -m elf_x86_64 -pie --script $(OPENORBIS)/link.x --eh-frame-hdr \
		-L$(OPENORBIS)/lib \
		$(OPENORBIS)/lib/crt1.o $(ENTROPY_MAIN_OBJECT) \
		--start-group $(BUILD_DIR)/libmbedtls-check.a $(BUILD_DIR)/liblibpeer-check.a --end-group \
		$(OPENORBIS_LIBS) \
		--unresolved-symbols=report-all --error-limit=0 \
		-o $@

$(LINK_TARGET): $(LINK_MAIN_OBJECT) $(LINK_ARCHIVES)
	$(LD) -m elf_x86_64 -pie --script $(OPENORBIS)/link.x --eh-frame-hdr \
		-L$(OPENORBIS)/lib \
		$(OPENORBIS)/lib/crt1.o $(LINK_MAIN_OBJECT) \
		--start-group $(LINK_ARCHIVES) --end-group \
		$(OPENORBIS_LIBS) \
		--unresolved-symbols=report-all --error-limit=0 \
		-o $@

$(SRTP_HEADER): $(ROOT)/extern/libpeer/third_party/libsrtp/include/srtp.h
	mkdir -p $(dir $@)
	cp $< $@

$(SRTP_CONFIG): $(SRTP_TEMPLATE)
	@mkdir -p $(dir $@)
	awk '\
		/#cmakedefine PACKAGE_VERSION/ {print "#define PACKAGE_VERSION \"2.4.2\""; next} \
		/#cmakedefine PACKAGE_STRING/ {print "#define PACKAGE_STRING \"libsrtp2 2.4.2\""; next} \
		/#cmakedefine HAVE_ARPA_INET_H 1/ {print "#define HAVE_ARPA_INET_H 1"; next} \
		/#cmakedefine HAVE_BYTESWAP_H 1/ {print "#define HAVE_BYTESWAP_H 1"; next} \
		/#cmakedefine HAVE_INTTYPES_H 1/ {print "#define HAVE_INTTYPES_H 1"; next} \
		/#cmakedefine HAVE_NETINET_IN_H 1/ {print "#define HAVE_NETINET_IN_H 1"; next} \
		/#cmakedefine HAVE_STDINT_H 1/ {print "#define HAVE_STDINT_H 1"; next} \
		/#cmakedefine HAVE_STDLIB_H 1/ {print "#define HAVE_STDLIB_H 1"; next} \
		/#cmakedefine HAVE_SYS_SOCKET_H 1/ {print "#define HAVE_SYS_SOCKET_H 1"; next} \
		/#cmakedefine HAVE_SYS_TYPES_H 1/ {print "#define HAVE_SYS_TYPES_H 1"; next} \
		/#cmakedefine HAVE_UNISTD_H 1/ {print "#define HAVE_UNISTD_H 1"; next} \
		/#cmakedefine HAVE_UINT8_T 1/ {print "#define HAVE_UINT8_T 1"; next} \
		/#cmakedefine HAVE_UINT16_T 1/ {print "#define HAVE_UINT16_T 1"; next} \
		/#cmakedefine HAVE_UINT32_T 1/ {print "#define HAVE_UINT32_T 1"; next} \
		/#cmakedefine HAVE_UINT64_T 1/ {print "#define HAVE_UINT64_T 1"; next} \
		/#cmakedefine HAVE_INT32_T 1/ {print "#define HAVE_INT32_T 1"; next} \
		/#cmakedefine HAVE_INET_ATON 1/ {print "#define HAVE_INET_ATON 1"; next} \
		/#cmakedefine HAVE_SIGACTION 1/ {print "#define HAVE_SIGACTION 1"; next} \
		/#cmakedefine HAVE_INLINE 1/ {print "#define HAVE_INLINE 1"; next} \
		/@SIZEOF_UNSIGNED_LONG_CODE@/ {print "#define SIZEOF_UNSIGNED_LONG 8"; next} \
		/@SIZEOF_UNSIGNED_LONG_LONG_CODE@/ {print "#define SIZEOF_UNSIGNED_LONG_LONG 8"; next} \
		/#cmakedefine [A-Z0-9_]+ 1/ {print "/* " $$0 " */"; next} \
		/#cmakedefine [A-Z0-9_]+ "@[^"]*"/ {print "/* " $$0 " */"; next} \
		/#cmakedefine [A-Z0-9_]+ @[^@]*@/ {print "/* " $$0 " */"; next} \
		{print} \
	' $< > $@

$(BUILD_DIR)/%.c.o: $(ROOT)/%.c $(JANSSON_PUBLIC_CONFIG)
	@mkdir -p $(dir $@)
	$(CC) $(COMMON_FLAGS) $(C_INCLUDE_FLAGS) $(CFLAGS) \
		$(if $(filter $(USRSCTP_DIR)/%,$<),$(USRSCTP_CFLAGS)) \
		$(if $(filter $(LIBPEER_DIR)/%,$<),$(LIBPEER_INCLUDE_FLAGS)) \
		$(if $(filter $(SRTP_DIR)/%,$<),$(SRTP_CFLAGS)) \
		-c $< -o $@

$(BUILD_DIR)/%.cpp.o: $(ROOT)/%.cpp $(JANSSON_PUBLIC_CONFIG)
	@mkdir -p $(dir $@)
	$(CXX) $(COMMON_FLAGS) $(CXX_INCLUDE_FLAGS) $(CXXFLAGS) \
		$(if $(filter $(WEBRTC_DIR)/%,$<),$(WEBRTC_INCLUDE_FLAGS)) \
		-c $< -o $@

clean:
	rm -rf $(BUILD_DIR)
